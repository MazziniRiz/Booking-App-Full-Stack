generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id        Int      @id @default(autoincrement())
  date      String
  time      String
  name      String
  email     String
  notes     String?
  createdAt DateTime @default(now())

  @@unique([date, time])
}
